# Copy this file to configs/server/qwen3_32b_2gpu_local.env on the server.
#
# This profile matches the current server layout reported by the user:
# - project under /home/ubuntu/lzz/MyAgent
# - model already downloaded at /home/ubuntu/models/Qwen3-32B
# - 2 RTX 4090 cards are used together for one Qwen3-32B vLLM service
# - current Gate runs use two generated services by default: 4,5 -> 8000 and 6,7 -> 8001

export HF_HOME=/home/ubuntu/models
export HF_HUB_ENABLE_HF_TRANSFER=1

export MODEL_ID=/home/ubuntu/models/Qwen3-32B
export SERVED_MODEL_NAME=qwen3-32b-local

# One service using both cards. Qwen3-32B normally needs tensor parallel on 2x4090.
export GPU_GROUPS="4,5"
export BASE_PORT=8000
export VLLM_API_KEY=local-vllm-key-change-me

export VLLM_MAX_MODEL_LEN=8192
export VLLM_GPU_MEMORY_UTILIZATION=0.88
export VLLM_DTYPE=auto
export VLLM_EXTRA_ARGS="--trust-remote-code"

# Used by myAgent OpenAI-compatible client.
export LOCAL_VLLM_API_KEY="<redacted>"

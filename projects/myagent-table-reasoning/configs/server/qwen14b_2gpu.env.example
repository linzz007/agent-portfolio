# Copy this file to configs/server/qwen14b_2gpu.env on the server.
#
# Default two-GPU plan:
# - 2 RTX 4090 24GB cards
# - one Qwen2.5-14B-AWQ vLLM service per GPU
# - myAgent splits every dataset into 2 shards and sends one shard to each service

export HF_HOME=/data/hf
export HF_HUB_ENABLE_HF_TRANSFER=1

export MODEL_ID=Qwen/Qwen2.5-14B-Instruct-AWQ
export SERVED_MODEL_NAME=qwen25-14b-awq

export GPU_GROUPS="0;1"
export BASE_PORT=8000
export VLLM_API_KEY=local-vllm-key-change-me

export VLLM_MAX_MODEL_LEN=8192
export VLLM_GPU_MEMORY_UTILIZATION=0.88
export VLLM_DTYPE=auto
export VLLM_EXTRA_ARGS="--trust-remote-code"

# Used by myAgent OpenAI-compatible client.
export LOCAL_VLLM_API_KEY="<redacted>"

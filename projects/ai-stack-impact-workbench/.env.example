# Copy this file to .env.local and fill in your own API key.
# .env.local is ignored by git and is loaded automatically by run_policy_api.py.

ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash
ANTHROPIC_AUTH_TOKEN=

# Optional runtime settings
POLICY_IMPACT_API_PORT=8501
AGENT_WORKBENCH_MODEL_MAX_TOKENS=2048
AGENT_WORKBENCH_MODEL_TEMPERATURE=0
AGENT_WORKBENCH_MODEL_TIMEOUT=45
AGENT_WORKBENCH_MODEL_ATTEMPTS=2

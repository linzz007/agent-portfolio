OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-v4-flash

EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=256

CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_STRATEGY=chapter_hybrid

TOP_K_RESULTS=3
RAG_TOPK_LEARN_PRACTICE=4
RAG_TOPK_EXAM=6
RETRIEVAL_MODE=hybrid
BM25_K1=1.5
BM25_B=0.75
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=1.0
HYBRID_BM25_WEIGHT=1.0
HYBRID_DENSE_CANDIDATES_MULTIPLIER=3
HYBRID_BM25_CANDIDATES_MULTIPLIER=3

CTX_TOTAL_TOKENS=8192
CTX_SAFETY_MARGIN=256
CB_HISTORY_RECENT_TURNS=6
CB_HISTORY_SUMMARY_MAX_TOKENS=700
CB_RAG_MAX_TOKENS=1800
CB_MEMORY_MAX_TOKENS=450
CB_RAG_SENT_PER_CHUNK=2
CB_RAG_SENT_MAX_CHARS=120
CB_MEMORY_TOPK=2
CB_MEMORY_ITEM_MAX_CHARS=100

API_HOST=0.0.0.0
API_PORT=8001
API_BASE=http://localhost:8001
SSE_HEARTBEAT_SEC=8
CONTEXT_BUDGET_EVENT_TIMEOUT_SEC=3.0

ENABLE_ROUTER_REPLAN=1
MEMORY_SEARCH_BACKEND=fts5

SERPAPI_API_KEY=

ENABLE_HARNESS_RUNTIME=1
HARNESS_RENDER_HTML=1
HARNESS_ARTIFACT_DIR=./data/runs

HARNESS_DEFAULT_MODEL=deepseek-v4-flash
HARNESS_DEFAULT_MODEL_TEMPERATURE=0.7
HARNESS_DEFAULT_MODEL_MAX_TOKENS=8192
HARNESS_DEFAULT_MODEL_TOP_P=1.0
HARNESS_DEFAULT_MODEL_TOP_K=50
HARNESS_DEFAULT_MODEL_FREQUENCY_PENALTY=0.0
HARNESS_DEFAULT_MODEL_PRESENCE_PENALTY=0.0
